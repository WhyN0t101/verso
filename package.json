{
  "name": "verso",
  "private": true,
  "version": "0.1.0",
  "description": "A 3D bookshelf for your reading life.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:vite": "vite",
    "worker": "wrangler dev",
    "build": "tsc --noEmit && vite build",
    "preview": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.168.0"
  }
}
